{
  "manifest_version": 3,
  "name": "icanhazux",
  "version": "1.3.0",
  "description": "Restyles icanhazchat.com: a cam grid you can arrange, cleaner chat, light and dark themes. Built on icanhazbetter by Sardistic.",
  "homepage_url": "https://github.com/plewds/icanhazux",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "icanhazux@icanhazux",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.icanhazchat.com/*"
      ],
      "js": [
        "src/core.js",
        "src/pack.js",
        "src/theme.js",
        "src/site.js",
        "src/pages.js",
        "src/shell.js",
        "src/cams.js",
        "src/upscale.js",
        "src/revive.js",
        "src/stamps.js",
        "src/controls.js",
        "src/chatbar.js",
        "src/menu.js",
        "src/pms.js",
        "src/pmlog.js",
        "src/people.js",
        "src/modtools.js",
        "src/memes.js",
        "src/media.js",
        "src/memespage.js",
        "src/ready.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.icanhazchat.com/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.icanhazchat.com/*"
      ],
      "css": [
        "styles/icanhazux.css",
        "styles/pages.css"
      ],
      "js": [
        "src/early.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.icanhazchat.com/*"
      ]
    }
  ]
}
